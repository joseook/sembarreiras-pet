# Copie para ".env" (na raiz do repositório) e ajuste os valores:
#   cp .env.example .env
# O .env é lido pelo back-end Flask (python-dotenv) e pelo Docker Compose.
# NUNCA versione o .env. Os valores abaixo são exemplos, não segredos reais.

# ---------- Flask ----------
# development | testing | production
FLASK_ENV=development
# Gere uma chave com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria
# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula). Nunca use "*".
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- PostgreSQL (docker-compose.yml) ----------
POSTGRES_USER=sembarreiras
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sembarreiras_pet
POSTGRES_PORT=5432

# URL usada pelo SQLAlchemy (driver psycopg 3). Repita os valores acima.
DATABASE_URL=postgresql+psycopg://sembarreiras:troque-esta-senha@localhost:5432/sembarreiras_pet

# ---------- Front-end (usado por `python manage.py frontend-config`) ----------
# Chave de NAVEGADOR do Google Maps JavaScript API. Deixe vazio para usar o fallback textual.
# Restrinja a chave por HTTP referrer e por API no Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# Opcional: Map ID do Google Cloud (padrão: DEMO_MAP_ID)
GOOGLE_MAPS_MAP_ID=
# Opcional: URL da API vista pelo navegador (padrão: http://localhost:5000/api)
FRONTEND_API_BASE_URL=http://localhost:5000/api
