# Configuração do Ambiente e Banco de Dados - Sem Barreiras Pet

# Ambiente Flask: 'development' ou 'production'
FLASK_ENV=development
FLASK_DEBUG=1

# Chave secreta para sessões
# Gere uma chave aleat?ria: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL de Conexão com o PostgreSQL
# Formato: postgresql+psycopg2://<usuario>:<senha>@<host>:<porta>/<nome_banco>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sembarreiras_db

# Fallback: Caso o PostgreSQL não esteja rodando ou configurado,
# o sistema pode operar temporariamente com SQLite local para desenvolvimento:
# DATABASE_URL=sqlite:///instance/sembarreiras.db
