# Ambiente local; em produção use APP_ENV=production (Vercel já é detectado).
APP_ENV=development
# Opcional localmente: chave aleatória gerada no processo. Em produção é obrigatória.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Sem URL: SQLite local no desenvolvimento. Em produção DATABASE_URL é obrigatória.
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco
# Somente se o frontend estiver em uma origem diferente da API:
FRONTEND_ORIGIN=
